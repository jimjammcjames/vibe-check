{
  "name": "vibe-check",
  "version": "1.0.0",
  "description": "Agent harness for safe, compounding AI-assisted development",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=4 harness-tests/tests/*.test.mjs",
    "test:local": "node --import tsx --test --test-concurrency=4 harness-tests/tests/agent-code-review.test.mjs harness-tests/tests/agent-memory-coherence.test.mjs harness-tests/tests/bootstrap-preflight.test.mjs harness-tests/tests/git-state.test.mjs harness-tests/tests/harness-cli.test.mjs harness-tests/tests/harness-config.test.mjs harness-tests/tests/http-provider.test.mjs harness-tests/tests/mcp-gen.test.mjs harness-tests/tests/mcp-gen-e2e.test.mjs harness-tests/tests/minimatch.test.mjs harness-tests/tests/policy-audit.test.mjs harness-tests/tests/skills.test.mjs harness-tests/tests/test-lint.test.mjs",
    "harness:bootstrap": "node .harness/framework/scripts/bootstrap-preflight.mjs",
    "harness:prep": "node .harness/framework/cli/harness.mjs prep",
    "harness:iterate": "node .harness/framework/cli/harness.mjs iterate",
    "harness:post": "node .harness/framework/cli/harness.mjs post",
    "harness:ci": "node .harness/framework/cli/harness.mjs ci",
    "harness:ci:codex": "node .harness/framework/cli/harness.mjs ci --codex",
    "harness:ci:copilot": "node .harness/framework/cli/harness.mjs ci --copilot",
    "harness:require-branch": "node .harness/framework/scripts/require-named-branch.mjs",
    "harness:simulate": "bash harness-tests/simulation/run.sh",
    "harness:new:entry": "node .harness/framework/cli/harness.mjs new:entry",
    "harness:new:meta": "node .harness/framework/cli/harness.mjs new:meta",
    "harness:new:session": "node .harness/framework/cli/harness.mjs new:session",
    "harness:migrate:history": "node .harness/framework/cli/harness.mjs migrate:history",
    "mcp-gen": "node workflows/bin/mcp-gen",
    "test:e2e": "node --import tsx --test harness-tests/tests/mcp-gen-e2e.test.mjs"
  },
  "keywords": [
    "agent",
    "harness",
    "ai",
    "development"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "tsx": "^4.21.0"
  }
}
